{
  "manifest_version": 3,
  "name": "NETRA Auto Link Scanner",
  "version": "1.0",
  "description": "Scans all links on a webpage for phishing threats",

  "permissions": ["activeTab", "scripting"],

  "host_permissions": [
  "http://127.0.0.1:8000/*",
  "http://localhost:8000/*"
],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}